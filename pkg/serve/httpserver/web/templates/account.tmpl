{{template "head" .}}
<body>
{{template "navbar" .}}
{{with .Content}}
<div class="container" style="max-width:720px;">
  <h1><i class="flu flu-person" aria-hidden="true"></i>Account</h1>
  <div class="muted-meta">
    Username {{.UserName}}{{if .Admin}} <span style="color:var(--text-muted);">(admin)</span>{{end}} · Type {{.TypeLabel}} · Created {{.CreatedAt.Format "2006-01-02"}} · <a href="/account/keys">SSH keys</a>
  </div>
  {{if .Error}}
  <div class="alert-error">{{.Error}}</div>
  {{end}}

  <h2 style="margin-top:1.5rem;">Profile</h2>
  <form method="POST" action="/account" style="margin-bottom:1.5rem;">
    <div class="form-group">
      <label>Username (read-only)</label>
      <input type="text" value="{{.UserName}}" disabled>
    </div>
    <div class="form-group">
      <label>Name</label>
      <input type="text" name="name" value="{{.Name}}">
    </div>
    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" value="{{.Email}}">
    </div>
    <button type="submit" class="btn">Save</button>
  </form>

  <h2>Change password</h2>
  <form method="POST" action="/account/password">
    <div class="form-group">
      <label>Current password</label>
      <input type="password" name="old_password" required placeholder="********">
    </div>
    <div class="form-group">
      <label>New password</label>
      <input type="password" name="new_password" required placeholder="********">
    </div>
    <button type="submit" class="btn">Change password</button>
  </form>
</div>
{{end}}
</body>
</html>
