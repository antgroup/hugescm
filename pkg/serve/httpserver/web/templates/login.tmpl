{{template "head" .}}
<body>
{{template "navbar" .}}
<div class="login-container">
  <h1>HugeSCM</h1>
  <p style="text-align:center; color:var(--text-muted); margin-bottom:1.5rem; font-size:0.9rem;">Sign in to your account</p>
  {{with .Content}}
  {{if .Error}}
  <div class="alert-error">{{.Error}}</div>
  {{end}}
  {{end}}
  <form method="POST" action="/login">
    <div class="form-group">
      <label><i class="flu flu-person"></i>Username</label>
      <input type="text" name="username" required autofocus>
    </div>
    <div class="form-group">
      <label><i class="flu flu-key"></i>Password</label>
      <input type="password" name="password" required>
    </div>
    <div style="margin-top:1.5rem;">
      <button type="submit" class="btn" style="width:100%;">Sign In</button>
    </div>
  </form>
</div>
</body>
</html>