{{template "head" .}}
<body>
{{template "navbar" .}}
{{with .Content}}
{{$c := .}}
<div class="container">
  <div class="repo-header">
    <div class="repo-title">
      <h1><i class="flu flu-org" aria-hidden="true"></i>{{$c.Namespace.Path}}</h1>
    </div>
    {{if $c.Namespace.Description}}
    <div class="repo-desc">
      <i class="flu flu-desc" aria-hidden="true"></i>{{$c.Namespace.Description}}
    </div>
    {{end}}
  </div>

  <h2><i class="flu flu-folder" aria-hidden="true"></i>Repositories</h2>
  {{if eq (len $c.Repos) 0}}
  <div class="empty-state">
    <i class="flu flu-folder flu-xl" aria-hidden="true"></i>
    <p>No repositories found in this namespace.</p>
  </div>
  {{else}}
  <div class="repo-grid">
    {{range $c.Repos}}
    <div class="repo-card">
      <div class="repo-name">
        <a href="/{{$c.Namespace.Path}}/{{.Path}}"><i class="flu flu-folder" aria-hidden="true"></i>{{.Path}}</a>
      </div>
      <div class="repo-desc">{{if .Description}}{{.Description}}{{else}}No description{{end}}</div>
      <div class="repo-meta">
        <span><i class="flu flu-branch" aria-hidden="true"></i>{{if eq .DefaultBranch ""}}mainline{{else}}{{.DefaultBranch}}{{end}}</span>
        <span>updated {{.UpdatedAt.Format "2006-01-02"}}</span>
      </div>
    </div>
    {{end}}
  </div>
  {{end}}
</div>
{{end}}
</body>
</html>