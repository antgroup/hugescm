{{template "head" .}}
<body>
{{template "navbar" .}}
{{with .Content}}
<div class="login-container" style="max-width:560px;">
  <h1><i class="flu flu-add" aria-hidden="true"></i>New Repository</h1>
  {{if .Error}}
  <div class="alert-error">{{.Error}}</div>
  {{end}}
  <form method="POST" action="/repos/new">
    <div class="form-group">
      <label><i class="flu flu-org" aria-hidden="true"></i>Namespace</label>
      <select name="namespace_path" required>
        {{range .Namespaces}}
        <option value="{{.Path}}">{{.Path}}</option>
        {{end}}
      </select>
      <div style="margin-top:0.3rem;font-size:0.85rem;">Need a new namespace? <a href="/namespaces/new">Create one</a></div>
    </div>
    <div class="form-group">
      <label><i class="flu flu-folder" aria-hidden="true"></i>Repository name</label>
      <input type="text" name="repo_path" required placeholder="my-project">
    </div>
    <div class="form-group">
      <label><i class="flu flu-desc" aria-hidden="true"></i>Description (optional)</label>
      <input type="text" name="description" placeholder="A short description">
    </div>
    <div class="form-group">
      <label><i class="flu flu-branch" aria-hidden="true"></i>Default branch (optional)</label>
      <input type="text" name="default_branch" placeholder="mainline">
    </div>
    <div class="form-group">
      <label><i class="flu flu-lock" aria-hidden="true"></i>Visibility</label>
      <select name="visible_level">
        <option value="private">Private</option>
        <option value="internal">Internal</option>
        <option value="public">Public</option>
      </select>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn"><i class="flu flu-add" aria-hidden="true"></i>Create repository</button>
      <a href="/repos" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
{{end}}
</body>
</html>